#!/bin/sh
# Runs the GitHub CLI with a short-lived GitHub App token from the github-token service (see
# github-token/server.py). The token is fetched per run and never stored.
#
# GH_LEVEL picks the access level (default github_read); the agent must have been granted it with
# `admin grant <name> --github ...`. git uses this wrapper as its GitHub credential helper (see
# gitconfig), so GH_LEVEL applies to `git push` too. The agent authenticates with its LiteLLM key,
# read from the environment or, when run outside Hermes, from $HERMES_HOME/.env.
if [ -z "${GH_TOKEN:-}" ]; then
  key="${LITELLM_API_KEY:-$(sed -n 's/^LITELLM_API_KEY=//p' "${HERMES_HOME:-/opt/data}/.env" 2>/dev/null)}"
  response="$(curl -sS --max-time 15 -w '\n%{http_code}' -H "Authorization: Bearer $key" \
    "http://github-token:8080/token/${GH_LEVEL:-github_read}")" || {
    echo "gh: couldn't reach the github-token service" >&2
    exit 1
  }
  status="$(printf '%s\n' "$response" | tail -n 1)"
  body="$(printf '%s\n' "$response" | sed '$d')"
  if [ "$status" != "200" ]; then
    echo "gh: no GitHub token (${GH_LEVEL:-github_read}): $body" >&2
    exit 1
  fi
  GH_TOKEN="$body"
  export GH_TOKEN
fi
export GH_NO_UPDATE_NOTIFIER=1 GH_PROMPT_DISABLED=1
exec /usr/local/lib/gh/gh "$@"
