# Mounted only into the litellm container. Copy to secrets/litellm.env and fill in.
# Generate random values with: openssl rand -hex 32

# The LiteLLM master key lives in secrets/master.env.
# Encrypts credentials LiteLLM stores in Postgres. Do not change after first start.
LITELLM_SALT_KEY=
# Password must match POSTGRES_PASSWORD in secrets/postgres.env.
DATABASE_URL=postgresql://litellm:CHANGEME@postgres:5432/litellm

# Models behind the fast / balanced / strong names in litellm/config.yaml, as LiteLLM
# "<provider>/<model>" strings. Switching provider means changing these and setting that
# provider's standard key variable below (e.g. OPENAI_API_KEY for openai/...).
LLM_MODEL_FAST=anthropic/claude-haiku-5-5
LLM_MODEL_BALANCED=anthropic/claude-sonnet-5-5
LLM_MODEL_STRONG=anthropic/claude-opus-5-5

# LLM provider credentials
ANTHROPIC_API_KEY=

# Tier classification for the `auto` model (see litellm/tier_classifier.py).
# Classifiers to try in order; "jev" is skipped when TYPESAFE_API_KEY is empty.
ROUTER_CLASSIFIERS=jev,llm
# model_list name the "llm" classifier calls.
ROUTER_CLASSIFIER_MODEL=fast
# TypeSafe credential for Jev. Jev receives the request text, recent turns, and system prompt.
# Optional: if empty, Jev is skipped.
TYPESAFE_API_KEY=

# Atlassian service-account API keys for Rovo MCP (sent as "Authorization: Bearer <key>").
# The read account should only have Jira and Confluence read scopes; each write account should add
# write scopes for its product only. A key is only needed if some agent is granted that server;
# with it empty, LiteLLM still starts, but the server fails for anyone granted it.
ROVO_READ_API_KEY=
ROVO_JIRA_WRITE_API_KEY=
ROVO_CONFLUENCE_WRITE_API_KEY=
