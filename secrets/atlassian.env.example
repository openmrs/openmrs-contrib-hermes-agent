# The Atlassian site mcp-atlassian serves (mcp-atlassian container only). Not secret: the
# Atlassian API keys are in secrets/litellm.env.
#
# JIRA_URL is the site, e.g. https://example.atlassian.net, and CONFLUENCE_URL the same with /wiki.
# The site's cloud ID is the "cloudId" in https://<site>/_edge/tenant_info.
JIRA_URL=
CONFLUENCE_URL=
ATLASSIAN_OAUTH_CLOUD_ID=
